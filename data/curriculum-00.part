        ],
        "title": "Klausuraufgabe: Fahrtkosten",
        "task": "Speichere gefahrene Kilometer und Kosten pro Kilometer. Berechne die Gesamtkosten und gib eine verständliche Ausgabe aus.",
        "requirements": [
          "kilometer speichern",
          "kosten_pro_kilometer speichern",
          "beide Werte multiplizieren",
          "Ergebnis ausgeben"
        ],
        "tests": [
          {
            "label": "kilometer vorhanden",
